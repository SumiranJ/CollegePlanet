@startuml CollegePlanetClassDiagram
hide methods
skinparam classAttributeIconSize 0
skinparam linetype ortho

class users <<table>> {
  +id: uuid <<PK>>
  email: text <<UNIQUE, NOT NULL>>
  password_hash: text <<nullable for SSO>>
  role: user_role <<NOT NULL>>
  created_at: timestamptz
  updated_at: timestamptz
}

class student_profiles <<table>> {
  +user_id: uuid <<PK, FK users.id>>
  first_name: text
  last_name: text
  institution: text
  major: text
  graduation_date: date
  resume_url: text
}

class student_interests <<table>> {
  +student_id: uuid <<PK, FK student_profiles.user_id>>
  +interest: text <<PK>>
}

class student_strengths <<table>> {
  +student_id: uuid <<PK, FK student_profiles.user_id>>
  +strength: text <<PK>>
}

class student_work_modes <<table>> {
  +student_id: uuid <<PK, FK student_profiles.user_id>>
  +work_mode: work_mode <<PK>>
}

class organizations <<table>> {
  +id: uuid <<PK>>
  name: text <<NOT NULL>>
  website_url: text
  created_at: timestamptz
}

class organization_memberships <<table>> {
  +organization_id: uuid <<PK, FK organizations.id>>
  +user_id: uuid <<PK, FK users.id>>
  member_role: text <<NOT NULL>>
  created_at: timestamptz
}

class jobs <<table>> {
  +id: uuid <<PK>>
  organization_id: uuid <<FK organizations.id>>
  created_by_user_id: uuid <<FK users.id>>
  title: text <<NOT NULL>>
  description: text <<NOT NULL>>
  location: text
  work_mode: work_mode
  employment_type: text
  experience_level: text
  salary_min: integer
  salary_max: integer
  application_url: text
  status: job_status <<NOT NULL>>
  created_at: timestamptz
  updated_at: timestamptz
}

class skills <<table>> {
  +id: uuid <<PK>>
  name: text <<UNIQUE, NOT NULL>>
}

class job_skill_requirements <<table>> {
  +job_id: uuid <<PK, FK jobs.id>>
  +skill_id: uuid <<PK, FK skills.id>>
  required: boolean
  proficiency: text
}

class job_relevant_majors <<table>> {
  +job_id: uuid <<PK, FK jobs.id>>
  +major: text <<PK>>
}

class job_interest_tags <<table>> {
  +job_id: uuid <<PK, FK jobs.id>>
  +interest: text <<PK>>
}

class saved_jobs <<table>> {
  +student_id: uuid <<PK, FK student_profiles.user_id>>
  +job_id: uuid <<PK, FK jobs.id>>
  saved_at: timestamptz
}

class applications <<table>> {
  +id: uuid <<PK>>
  student_id: uuid <<FK student_profiles.user_id>>
  job_id: uuid <<FK jobs.id>>
  status: application_status <<NOT NULL>>
  profile_snapshot: jsonb
  submitted_at: timestamptz
  created_at: timestamptz
}

class career_roles <<table>> {
  +id: uuid <<PK>>
  title: text <<NOT NULL>>
  description: text
}

class roadmaps <<table>> {
  +id: uuid <<PK>>
  student_id: uuid <<FK student_profiles.user_id>>
  career_role_id: uuid <<FK career_roles.id>>
  status: roadmap_status
  created_at: timestamptz
  updated_at: timestamptz
}

class roadmap_milestones <<table>> {
  +id: uuid <<PK>>
  roadmap_id: uuid <<FK roadmaps.id>>
  title: text <<NOT NULL>>
  description: text
  display_order: integer <<NOT NULL>>
  status: milestone_status
  target_date: date
  completed_at: timestamptz
}

class roadmap_goals <<table>> {
  +id: uuid <<PK>>
  roadmap_id: uuid <<FK roadmaps.id>>
  title: text <<NOT NULL>>
  description: text
  status: milestone_status
  target_date: date
  display_order: integer
  created_at: timestamptz
  updated_at: timestamptz
}

class assessments <<table>> {
  +id: uuid <<PK>>
  title: text <<NOT NULL>>
  version: integer <<NOT NULL>>
  is_active: boolean
}

class assessment_questions <<table>> {
  +id: uuid <<PK>>
  assessment_id: uuid <<FK assessments.id>>
  prompt: text <<NOT NULL>>
  display_order: integer <<NOT NULL>>
  response_type: text
}

class assessment_choices <<table>> {
  +id: uuid <<PK>>
  question_id: uuid <<FK assessment_questions.id>>
  label: text <<NOT NULL>>
  display_order: integer
}

class assessment_attempts <<table>> {
  +id: uuid <<PK>>
  student_id: uuid <<FK student_profiles.user_id>>
  assessment_id: uuid <<FK assessments.id>>
  status: attempt_status
  started_at: timestamptz
  submitted_at: timestamptz
}

class assessment_responses <<table>> {
  +id: uuid <<PK>>
  attempt_id: uuid <<FK assessment_attempts.id>>
  question_id: uuid <<FK assessment_questions.id>>
  choice_id: uuid <<FK assessment_choices.id, nullable>>
  answer_text: text
  answered_at: timestamptz
}

users "1" -- "0..1" student_profiles : owns
student_profiles "1" -- "0..*" student_interests
student_profiles "1" -- "0..*" student_strengths
student_profiles "1" -- "0..*" student_work_modes
users "1" -- "0..*" organization_memberships
organizations "1" -- "0..*" organization_memberships
organizations "1" -- "0..*" jobs : posts
users "1" -- "0..*" jobs : creates
jobs "1" -- "0..*" job_skill_requirements
skills "1" -- "0..*" job_skill_requirements
jobs "1" -- "0..*" job_relevant_majors
jobs "1" -- "0..*" job_interest_tags
student_profiles "1" -- "0..*" saved_jobs
jobs "1" -- "0..*" saved_jobs
student_profiles "1" -- "0..*" applications
jobs "1" -- "0..*" applications
student_profiles "1" -- "0..*" roadmaps
career_roles "1" -- "0..*" roadmaps : target role
roadmaps "1" -- "0..*" roadmap_milestones
roadmaps "1" -- "0..*" roadmap_goals
assessments "1" -- "0..*" assessment_questions
assessment_questions "1" -- "0..*" assessment_choices
student_profiles "1" -- "0..*" assessment_attempts
assessments "1" -- "0..*" assessment_attempts
assessment_attempts "1" -- "0..*" assessment_responses
assessment_questions "1" -- "0..*" assessment_responses
assessment_choices "0..1" -- "0..*" assessment_responses : selected choice

note bottom of users
  role distinguishes student and employer accounts.
  email is unique case-insensitively.
  Passwords are stored only as strong hashes.
end note

note bottom of jobs
  CHECK salary_min IS NULL OR salary_min >= 0
  CHECK salary_max IS NULL OR salary_max >= 0
  CHECK salary_min IS NULL OR salary_max IS NULL
     OR salary_min <= salary_max
  Employers may edit only jobs in their organization.
end note

note bottom of saved_jobs
  Composite primary key (student_id, job_id)
  prevents duplicate saves.
end note

note bottom of applications
  UNIQUE (student_id, job_id) if one application
  per student/job is the product rule.
  Preserve profile_snapshot for submission history.
end note

note bottom of assessment_responses
  UNIQUE (attempt_id, question_id) for one response
  per question. Enforce choice/question consistency
  and required-choice rules in the application or DB.
end note

note bottom of roadmaps
  Consider a partial unique index on student_id
  where status = 'active' if only one active roadmap
  is allowed per student.
end note

legend bottom
  PK = primary key; FK = foreign key
  Delete dependent private rows with their owner;
  retain submitted applications when jobs are closed/deleted
  through soft deletion or restricted deletion.
endlegend
@enduml
